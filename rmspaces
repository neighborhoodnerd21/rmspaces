      # :flag.case
      --dash | -d)

        # :flag.case_no_arg
        args['--dash']=1
        shift
        ;;

      # :flag.case
      --underscore | -u)

        # :flag.case_no_arg
        args['--underscore']=1
        shift
        ;;

      # :flag.case
      --period | -p)

        # :flag.case_no_arg
        args['--period']=1
        shift
