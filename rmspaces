        echo "Error: '$f' is a directory." >&2
        exit 1
      else
        fext=".${f##*.}"
        fnoext="${f%.*}"
        if [[ $dash ]]; then
          # shellcheck disable=SC2001
          new_name=$(echo "${fnoext}" | sed 's/[^A-Za-z0-9-]/-/g')
          new_name="${new_name}${fext}"
        elif [[ $underscore ]]; then
          # shellcheck disable=SC2001
          new_name=$(echo "${fnoext}" | sed 's/[^A-Za-z0-9_]/_/g')
          new_name="${new_name}${fext}"
        elif [[ $period ]]; then
          # shellcheck disable=SC2001
          new_name=$(echo "${fnoext}" | sed 's/[^A-Za-z0-9.]/./g')
